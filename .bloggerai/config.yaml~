# ──────────────────────────────────────────────────────────────────────────────
# bloggerai configuration
# Edit this file to customise your blog and the AI pipeline.
# Env-var tokens like ${OPENAI_API_KEY} are expanded at runtime.
# ──────────────────────────────────────────────────────────────────────────────

blog:
  # REQUIRED — unique slug identifier for this blog (used in logging and tooling).
  id: agentic-coding
  # Optional — human-readable title. Defaults to title-cased id when omitted.
  # Examples: "My Tech Blog", "Digital Credentials for Children"
  title: "Agentic Coding"
  # One-paragraph summary of the blog's purpose. Shared with every agent as
  # context so posts stay on-topic.
  description: "Blog dedicated to the development of agents, tools, harness, mcps and anything related with automating the software development."
  author: "Ian Merlos"
  # Short bio displayed at the bottom of every post.
  # Leave blank to omit the author bio section.
  author_bio: "I am agent myself. I love writing about how to use agents to build software. Test skills, harnesses and agentic pipelines."
  # BCP-47 language tag — posts will be written in this language.
  # Examples: en, es, fr, de, pt, zh
  language: en
  # Who the posts are written for. Helps the writer and reviewer tailor tone
  # and vocabulary. Leave blank to let the style file decide.
  audience: "software developers"
  # Writing style — controls the system prompt sent to the writer.
  # Options: technical | casual | academic | storytelling | listicle
  # You can fully customise the prompt by editing .bloggerai/style.md
  style: storytelling
  # Target post length in words [min, max].
  word_range: [600, 1200]
  # Approx. Maximum number of characters allowed in a generated post title.
  title_max_length: 60
  # Number of writer ⇄ reviewer revision loops per post (0 = no review).
  review_iterations: 1
  # How many recent post titles to load for deduplication checks.
  recent_titles_lookback: 20
  # Quarto HTML theme applied to the rendered site.
  # Options: default | cosmo | flatly | minty | solar | lux | morph | slate | vapor
  quarto_theme: slate
  # Allow the writer to embed Mermaid and Graphviz diagrams in posts.
  # Diagrams are validated after generation — invalid blocks are stripped with a warning.
  # Set to false for plain-text-only blogs or themes that don't render diagrams.
  diagrams: true
  # Optional references injected into the writer prompt.
  # internal: relative paths to existing posts the writer should link to.
  # external: URLs the writer should cite.
  references:
    internal: []
    external: []

# ──────────────────────────────────────────────────────────────────────────────
# LLM settings
# bloggerai uses LiteLLM, so any provider it supports works here.
# ──────────────────────────────────────────────────────────────────────────────
llm:
  # Default model used by all agents unless overridden in agent_models below.
  # Examples:
  #   OpenAI   : gpt-4o | gpt-4o-mini | o1-mini
  #   Anthropic: anthropic/claude-3-5-sonnet-20241022
  #   Ollama   : ollama/llama3.3 | ollama/qwen2.5:14b
  #   Azure    : azure/<deployment-name>
  #   Gemini   : gemini/gemini-1.5-pro
  model: ollama/qwen3.8:27b
  # API key or env-var token. Use ${VAR_NAME} to avoid hard-coding secrets.
  # OpenAI   → ${OPENAI_API_KEY}
  # Anthropic → ${ANTHROPIC_API_KEY}
  # Azure    → ${AZURE_API_KEY}
  # Ollama   → leave blank (no key required)
  api_key: ah_AFy68zhttpllpx4DNaD8jMPwtLBRZkGSCfGvO1zj
  # Override the provider endpoint. Required for Ollama and Azure.
  # Ollama example : http://localhost:11434
  # Azure  example : https://<resource>.openai.azure.com
  api_base: "http://localhost:43102/v1"
  # Azure API version only — leave blank for all other providers.
  api_version: ""
  # Sampling temperature for the default model (0.0 = deterministic, 2.0 = creative).
  temperature: 0.7
  # Per-agent model overrides. Leave a value blank to use the default model above.
  # Useful for routing creative tasks (writer, obfuscator) to a larger/cheaper model
  # and precision tasks (reviewer, metadator) to a faster, more deterministic one.
  agent_models:
    title_creator: ""
    writer: ""
    reviewer: ""
    obfuscator: ""
    metadator: ""

# ──────────────────────────────────────────────────────────────────────────────
# Image generation (optional)
# Set provider to enable automatic cover image generation during post generation.
# Leave provider blank ("") to disable.
# ──────────────────────────────────────────────────────────────────────────────
image:
  # Provider to use. Options: gradient | openai | sdnext | bedrock | vertex | replicate | fal | ""
  # gradient: Python-generated abstract cover image — no API key or internet required.
  #           A seeded gradient + geometric shapes are rendered locally via Pillow.
  provider: "sdnext"
  # Model/checkpoint — auto-defaulted per provider when left blank:
  #   openai   : dall-e-3  (also accepts: gpt-image-1 | dall-e-2)
  #   sdnext   : blank = active checkpoint on the running server
  #   bedrock  : stability.stable-diffusion-xl-v1
  #   vertex   : imagegeneration@006
  #   replicate: black-forest-labs/flux-schnell
  #   fal      : fal-ai/fast-sdxl
  #   gradient : (model field is not used)
  model: ""
  # API key env-var token — auto-defaulted per provider when left blank:
  #   openai   : ${OPENAI_API_KEY}
  #   replicate: ${REPLICATE_API_TOKEN}
  #   fal      : ${FAL_KEY}
  #   gradient / sdnext / bedrock / vertex: not required here
  api_key: ""
  # API base URL — auto-defaulted to http://localhost:7860 when provider is sdnext
  # and left blank. Required only for sdnext; leave blank for all other providers.
  api_base: "http://localhost:7860"
  # Output image dimensions (width x height in pixels).
  # Default 1200x630 matches the OG/social card ratio and the gradient fallback.
  # Exception: openai auto-defaults to 1024x1024 (its native default) when this
  # field is left at 1200x630, since that ratio is not accepted by the openai API.
  # OpenAI also accepts: 1792x1024 | 1024x1792
  size: "1200x630"
  # AWS region — required for bedrock.
  aws_region: "us-east-1"
  # GCP project and location — required for vertex.
  gcp_project: ""
  gcp_location: "us-central1"
  # LLM model used to generate the image prompt text.
  # Leave blank to use the default llm.model. Override to use a cheaper/faster
  # model for this lightweight task (e.g. gpt-4o-mini, ollama/llama3.2).
  prompt_model: ""
  # Extra style instructions appended to the image-prompt system message.
  # Use this to steer the visual style of every generated cover image.
  # Examples:
  #   "photorealistic, warm golden tones, minimalist composition"
  #   "flat illustration, pastel colours, isometric perspective"
  #   "dark cinematic, high contrast, moody atmosphere"
  # Leave blank to use the built-in defaults.
  prompt_instructions: ""
  # When provider is blank, automatically generate a gradient cover image.
  # Set to false to disable all cover image generation when no provider is configured.
  fallback_gradient: true
